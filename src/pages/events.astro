---
import MainLayout from "../layouts/MainLayout.astro";
import EventHero from "../components/events/EventHero.astro";
import EventActivities from "../components/events/EventActivities.astro";
import CompetitionList from "../components/events/CompetitionList.astro";
import UpcomingEvent from "../components/events/UpcomingEvent.astro";
// import PreviousEvents from "../components/events/PreviousEvents.astro";
import type { Lang } from "../i18n";
import { getTranslations } from "../i18n";

const lang: Lang = "bg";
const t = getTranslations(lang);
---

<MainLayout
  title={t.events.pageTitle}
  lang={lang}
>
  <EventHero lang={lang} />
  <EventActivities lang={lang} />
  <UpcomingEvent lang={lang} />
  <CompetitionList lang={lang} />
  
  <!-- <PreviousEvents lang={lang} /> -->

</MainLayout>
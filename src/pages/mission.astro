---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/mission.css";
import {Compass, Sprout, Leaf, Signpost, Waypoints, HeartHandshake, Users } from "../lib/icons";
import type { Lang } from "../i18n";
import { getTranslations } from "../i18n";

const lang: Lang = "bg";
const t = getTranslations(lang);
---

<MainLayout
  title={t.mission.pageTitle}
  lang={lang}
>

  <main>
    <section class="mission-hero">
      <div class="container">
        <Compass class="hero-icon" />
        <h1>{t.mission.hero.title}</h1>
        <h2 class="mission-lead">
          {t.mission.hero.lead}
        </h2>
        <p class="mission-intro">
          {t.mission.hero.intro}
        </p>
      </div>
    </section>

    <section class="mission-values">
      <div class="container">
        <h2>{t.mission.values.title}</h2>
        <div class="values-grid">
          
          <article class="value-card">
            <div class="value-icon">
              <Sprout class="icon-svg" />
            </div>
            <h3>{t.mission.values.nature.title}</h3>
            <p>
                {t.mission.values.nature.description}
              </p>
          </article>

          <article class="value-card">
            <div class="value-icon">
              <Waypoints class="icon-svg" />
            </div>
            <h3>{t.mission.values.trails.title}</h3>
            <p>
              {t.mission.values.trails.description}
            </p>
          </article>

          <article class="value-card">
            <div class="value-icon">
              <HeartHandshake class="icon-svg" />
            </div>
            <h3>{t.mission.values.community.title}</h3>
            <p>
              {t.mission.values.community.description}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="mission-work">
      <div class="container">
        <h2>{t.mission.work.title}</h2>
        <div class="work-grid">
          <article class="work-item">
            <div class="work-icon">
              <HeartHandshake class="icon-svg" />
            </div>
            <h3>{t.mission.work.lifestyle.title}</h3>
            <p>
              {t.mission.work.lifestyle.description}
            </p>
          </article>
          
          <article class="work-item">
            <div class="work-icon">
              <Leaf class="icon-svg" />
            </div>
            <h3>{t.mission.work.conservation.title}</h3>
            <p>
              {t.mission.work.conservation.description}
            </p>
          </article>
          <article class="work-item">
            <div class="work-icon">
              <Signpost class="icon-svg" />
            </div>
            <h3>{t.mission.work.maintenance.title}</h3>
            <p>
              {t.mission.work.maintenance.description}
            </p>
          </article>
          
          <article class="work-item">
            <div class="work-icon">
              <Users class="icon-svg" />
            </div>
            <h3>{t.mission.work.communities.title}</h3>
            <p>
              {t.mission.work.communities.description}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="mission-contact">
      <article class="container">
        <h2>{t.mission.contact.title}</h2>
        <div class="contact-grid">
          <div class="contact-item">
            <h3>{t.mission.contact.email}</h3>
            <p>
              <a href="mailto:ngo.travna@gmail.com">
                ngo.travna@gmail.com
              </a>
            </p>
          </div>
          <div class="contact-item">
            <h3>{t.mission.contact.instagram}</h3>
            <p>
              <a href="https://www.instagram.com/ngo.travna">
                @ngo.travna
              </a>
            </p>
          </div>
          <div class="contact-item">
            <h3>{t.mission.contact.facebook}</h3>
            <p>
              <a href="#">
                @ngo.travna
              </a>
            </p>
          </div>
        </div>
      </article>
    </section>
  </main>
</MainLayout>

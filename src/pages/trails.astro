---
import MainLayout from "../layouts/MainLayout.astro";
import TrailsHero from "../components/trails/TrailsHero.astro";
import TrailList from "../components/trails/TrailList.astro";
import { supabase } from "../lib/supabase";

const { data: trails, error } = await supabase
  .from("trails")
  .select(`
    id,
    slug,
    status,
    last_visited,
    distance_km,
    elevation_gain,
    trail_translations (
      language,
      title,
      description
    )
  `);

if (error) {
  console.error("Failed to fetch trails:", error);
}
---

<MainLayout title="Trails | TRAVNA" lang="bg">
  <TrailsHero />
  <TrailList trails={trails ?? []} />
</MainLayout>
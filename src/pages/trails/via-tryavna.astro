---
import MainLayout from "../../layouts/MainLayout.astro";

import TrailHero from "../../components/trail/TrailHero.astro";
import TrailOverview from "../../components/trail/TrailOverview.astro";
import TrailDescription from "../../components/trail/TrailDescription.astro";
import TrailMap from "../../components/trail/TrailMap.astro";
import TrailGallery from "../../components/trail/TrailGallery.astro"; 
import TrailMaintenance from "../../components/trail/TrailMaintenance.astro";
import TrailRelated from "../../components/trail/TrailRelated.astro";
import trail from "../../data/trails/via-tryavna";
---

<MainLayout
  title="Via Tryavna | TRAVNA"
  lang="bg"
>

  <TrailHero trail={trail} />
  <TrailOverview trail={trail} />
  <TrailDescription />
  <TrailMap trail={trail} />
  <TrailGallery />
  <TrailMaintenance />
  <TrailRelated />
</MainLayout>
<!-- I would like to tell you that I prefer a different look of via-tryavna.astro layout. 1. TrailOverview to be one card with separate fields not six different cards. 2. Without difficulty, but with Trail Care and Last maintenance is enough for it. 3. TrailHero need to be more visual, now the font color is similar as the background color.   -->
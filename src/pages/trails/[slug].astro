---
import MainLayout from "../../layouts/MainLayout.astro";

import TrailHero from "../../components/trail/TrailHero.astro";
import TrailOverview from "../../components/trail/TrailOverview.astro";
import TrailDescription from "../../components/trail/TrailDescription.astro";
import TrailMap from "../../components/trail/TrailMap.astro";
import TrailGallery from "../../components/trail/TrailGallery.astro";
import TrailRelated from "../../components/trail/TrailRelated.astro";
import trail from "../../data/trails/via-tryavna";
import { supabase } from "../../lib/supabase";
const { slug } = Astro.params;

export async function getStaticPaths() {
  const { data: trails, error } = await supabase
    .from("trails")
    .select("slug");

  if (error) {
    console.error(error);
    return [];
  }

  return trails.map((trail) => ({
    params: {
      slug: trail.slug,
    },
  }));
}
---

<MainLayout
  title="Обиколката на Трявна | ТРЪВНА"
  lang="bg"
>

  <TrailHero trail={trail} />
  <TrailOverview trail={trail} />
  <TrailDescription />
  <TrailMap trail={trail} />
  <TrailGallery trail={trail} />
  <TrailRelated trails={[]} />

</MainLayout>
---
import MainLayout from "../../layouts/MainLayout.astro";
import TrailHero from "../../components/trail/TrailHero.astro";
import TrailOverview from "../../components/trail/TrailOverview.astro";
import TrailDescription from "../../components/trail/TrailDescription.astro";
import TrailMap from "../../components/trail/TrailMap.astro";
import TrailGallery from "../../components/trail/TrailGallery.astro";
import TrailRelated from "../../components/trail/TrailRelated.astro";
import { supabase } from "../../lib/supabase";
import { mapSupabaseTrail } from "../../types/mapTrail";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
const lang = isEnglish ? "en" : "bg";

export async function getStaticPaths() {
  const { data: trails, error } = await supabase
    .from("trails")
    .select("slug");

  if (error) {
    console.error(error);
    return [];
  }

  return trails.map((trail) => ({
    params: { slug: trail.slug },
  }));
}

const { slug } = Astro.params;

const { data: supabaseTrail, error } = await supabase
  .from("trails")
  .select(`
    id,
    slug,
    status,
    last_visited,
    distance_km,
    elevation_gain,
    highest_point,
    duration_hours,
    gpx_file,
    trail_translations (
      language,
      title,
      description
    ),
    trail_images (
      id,
      image_path,
      display_order,
      caption
    )
  `)
  .eq("slug", slug)
  .single();

if (error || !supabaseTrail) {
  return new Response(null, {
    status: 404,
    statusText: "Trail not found",
  });
}

const trailData = mapSupabaseTrail(supabaseTrail);

const { data: trailRelations, error: relationsError } = await supabase
  .from("trail_relations")
  .select(`
    id,
    related_trail_id,
    external_title,
    external_url,
    relation_type,
    display_order,
    related_trail:trails!trail_relations_related_trail_id_fkey (
      id,
      slug,
      status,
      distance_km,
      elevation_gain,
      highest_point,
      duration_hours,
      trail_translations (
        language,
        title,
        description
      ),
      trail_images (
        id,
        image_path,
        display_order,
        caption
      )
    )
  `)
  .eq("trail_id", supabaseTrail.id)
  .order("display_order", { ascending: true });

if (relationsError) {
  console.error("TRAIL RELATIONS ERROR:", relationsError);
}
// console.log(
//   "TRAIL RELATIONS:",
//   JSON.stringify(trailRelations, null, 2)
// );

const relatedTrails = (trailRelations ?? []).map(
  (relation): {
    type: "internal" | "external";
    title: string;
    href: string;
  } => {
    const relatedTrail = Array.isArray(relation.related_trail)
      ? relation.related_trail[0]
      : relation.related_trail;

    if (relatedTrail) {
      const translation = relatedTrail.trail_translations?.[0];

      return {
        type: "internal",
        title: translation?.title ?? relatedTrail.slug,
        href: `/trails/${relatedTrail.slug}`,
      };
    }

    return {
      type: "external",
      title: relation.external_title ?? "Related trail",
      href: relation.external_url ?? "#",
    };
  },
);

---

<MainLayout
  title={`${trailData.title} | ${lang === "bg" ? "ТРЪВНА" : "TRAVNA"}`}
  lang={lang}
>
  <TrailHero trail={trailData} />
  <TrailOverview trail={trailData} />
  <TrailDescription trail={trailData} />
  <TrailMap trail={trailData} />
  <TrailGallery trail={trailData} images={trailData.gallery} />
  <TrailRelated trails={relatedTrails} />
</MainLayout>
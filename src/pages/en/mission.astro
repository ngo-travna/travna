---
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/mission.css";
---

<MainLayout
  title="Mission | TRAVNA"
  description="Learn about the mission and values of TRAVNA."
>

  <main>
    <section class="mission-hero">
      <div class="container">
        <h1>Mission</h1>
        <p class="mission-lead">
          Caring for the trails and local communities of the Balkan Mountains and the Tryavna region
        </p>
        <p class="mission-intro">
          TRAVNA is a non-governmental organization dedicated to maintaining
          mountain trails, supporting responsible outdoor recreation and
          promoting the natural and cultural heritage of the region.
        </p>
      </div>
    </section>

    <section class="mission-values">
      <div class="container">
        <h2>Our Values</h2>
        <div class="values-grid">
          
          <article class="value-card">
            <div class="value-icon">🌿</div>
            <h3>Nature</h3>
            <p>
              We care for the forests and landscapes that make the Balkan unique.
            </p>
          </article>

          <article class="value-card">
            <div class="value-icon">🥾</div>
            <h3>Trails</h3>
            <p>
              We maintain and improve hiking, running and cycling routes
              so everyone can explore them safely.
            </p>
          </article>

          <article class="value-card">
            <div class="value-icon">🤝</div>
            <h3>Community</h3>
            <p>
              We bring together local people and outdoor
              enthusiasts to care for the places we love.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="mission-work">
      <div class="container">
        <h2>What We Do</h2>
        <div class="work-grid">
          <article class="work-item">
            <div class="work-icon">🌿</div>
            <h3>Nature Conservation</h3>
            <p>
              We promote responsible outdoor recreation that respects wildlife,
              forests and mountain ecosystems.
            </p>
          </article>
          <article class="work-item">
            <div class="work-icon">🗺️</div>
            <h3>Trail Maintenance</h3>
            <p>
              We maintain and improve mountain trails to keep them safe,
              accessible and enjoyable throughout the year.
            </p>
          </article>
          <article class="work-item">
            <div class="work-icon">🤝</div>
            <h3>Volunteer Initiatives</h3>
            <p>
              We organize community events and encourage people to do sport, to be active and take part in
              caring for the places they love.
            </p>
          </article>
          <article class="work-item">
            <div class="work-icon">🏡</div>
            <h3>Local Communities</h3>
            <p>
              We support sustainable tourism and celebrate the culture and
              traditions of the Central Balkan region.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="mission-contact">

  <div class="container">

    <h2>Contact</h2>

    <div class="contact-grid">

      <div class="contact-item">
        <h3>Email</h3>
        <p>
          <a href="mailto:ngo.travna@gmail.com">
            ngo.travna@gmail.com
          </a>
        </p>
      </div>

      <div class="contact-item">
        <h3>Instagram</h3>
        <p>
          <a href="#">
            @travna
          </a>
        </p>
      </div>

      <div class="contact-item">
        <h3>Facebook</h3>
        <p>
          <a href="#">
            TRAVNA
          </a>
        </p>
      </div>

    </div>

  </div>

</section>

  </main>
</MainLayout>
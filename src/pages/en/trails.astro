---
import MainLayout from "../../layouts/MainLayout.astro";
import TrailsHero from "../../components/trails/TrailsHero.astro";
import TrailList from "../../components/trails/TrailList.astro";
import TrailsMap from "../../components/trails/TrailsMap.astro";
import { supabase } from "../../lib/supabase";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

const lang: Lang = "en";
const t = getTranslations(lang);

const { data: trails, error } = await supabase
  .from("trails")
  .select(`
    id,
    slug,
    status,
    last_visited,
    distance_km,
    elevation_gain,
    gpx_file,
    trail_translations (
      language,
      title,
      description
    )
  `);

if (error) {
  console.error("Failed to fetch trails:", error);
}

const mapTrails = (trails ?? [])
  .filter((trail) => trail.gpx_file)
  .map((trail) => ({
    slug: trail.slug,
    title:
      trail.trail_translations.find((tr) => tr.language === lang)?.title ??
      trail.trail_translations[0]?.title ??
      "",
  }));
---

<MainLayout
  title={t.trails.pageTitle}
  lang={lang}
>
  <TrailsHero lang={lang} />
  <TrailsMap
    trails={mapTrails}
    prefix="/en"
    label={t.trails.overviewMap}
  />
  <TrailList trails={trails ?? []} lang={lang} />
</MainLayout>
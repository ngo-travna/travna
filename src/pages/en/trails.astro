---
import MainLayout from "../../layouts/MainLayout.astro";
import TrailsHero from "../../components/trails/TrailsHero.astro";
import TrailList from "../../components/trails/TrailList.astro";
import { supabase } from "../../lib/supabase";

import bg from "../../i18n/bg";
import en from "../../i18n/en";
const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
const lang = isEnglish ? "en" : "bg";

const { data: trails, error } = await supabase
  .from("trails")
  .select(`
    id,
    slug,
    status,
    last_visited,
    distance_km,
    elevation_gain,
    trail_translations (
      language,
      title,
      description
    )
  `);

if (error) {
  console.error("Failed to fetch trails:", error);
}
---

<MainLayout
  title={t.trails.pageTitle}
  lang={lang}
>
  <TrailsHero />
  <TrailList trails={trails ?? []} />
</MainLayout>
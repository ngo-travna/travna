---
import "./trails-hero.css";
import { Route } from "../../lib/icons";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getTranslations(lang);
---
<section class="trails-hero">
  <div class="container">
    <Route class="hero-icon" />
    <h1>{t.trails.hero.title}</h1>
    <h2 class="trail-lead">
      {t.trails.hero.description}
    </h2>
  </div>
</section>
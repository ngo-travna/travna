---
import "./trails-hero.css";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---
<section class="trails-hero">
  <div class="container">
    <h1>{t.trails.hero.title}</h1>
    <p>
      {t.trails.hero.description}
    </p>
  </div>
</section>
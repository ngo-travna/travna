---
import "./trails-map.css";

interface Props {
  trails: { slug: string; title: string }[];
  prefix: string;
  label: string;
}

const { trails, prefix, label } = Astro.props;
---

{trails.length > 0 && (
  <section class="trails-map">
    <div class="container">
      <div
        id="trails-map"
        role="region"
        aria-label={label}
        aria-busy="true"
        data-trails={JSON.stringify(trails)}
        data-prefix={prefix}
      ></div>
    </div>
  </section>
)}

<script>
  import { initTrailsMap } from "../../scripts/trails-map";

  const container = document.getElementById("trails-map");

  if (container) {
    // The map is the first thing on the page, so don't compete with the page's
    // own rendering: wait until the page has fully loaded and the browser is
    // idle. The grey placeholder is shown meanwhile.
    const start = () => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(() => initTrailsMap(), { timeout: 2000 });
      } else {
        setTimeout(initTrailsMap, 200);
      }
    };

    if (document.readyState === "complete") {
      start();
    } else {
      window.addEventListener("load", start, { once: true });
    }
  }
</script>

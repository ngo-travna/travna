---
import TrailCard from "./TrailCard.astro";
---

<section class="trails-grid">

  <div class="container">

    <h2>Our Trails</h2>

    <div class="trail-grid">

      <TrailCard
        title="Via Tryavna"
        image="/images/trails/via-trayana.jpg"
        href="/trails/via-tryavna"
        status="green"
      />

      <TrailCard
        title="Tryavna Eco Trail"
        image="/images/trails/tryavna.jpg"
        href="/trails/via-tryavna"
        status="yellow"
      />

      <TrailCard
        title="Buzludzha Ridge"
        image="/images/trails/buzludzha.jpg"
        href="/trails/buzludzha"
        status="red"
      />

    </div>

  </div>

</section>
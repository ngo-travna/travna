---
import "./trail-list.css";
import bg from "../../i18n/bg";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

type TrailStatus = keyof typeof bg.trails.list.status;

interface Props {
  trails: {
    id: string;
    slug: string;
    status: TrailStatus;
    last_visited: string;
    distance_km: number;
    elevation_gain: number;
    trail_translations: {
      language: string;
      title: string;
      description: string;
    }[];
  }[];
  lang: Lang;
}

const { trails, lang } = Astro.props;
const t = getTranslations(lang);
const isEnglish = lang === "en";

const statuses: TrailStatus[] = [
  "maintained",
  "partly_maintained",
  "passed_by_travna",
];
---

<section class="trail-list">
  <div class="container">
    <div class="trail-controls">
      <input
        type="text"
        class="trail-search"
        placeholder={t.trails.list.searchPlaceholder}
        aria-label={t.trails.list.searchPlaceholder}
      />
      <div class="trail-status-filter" role="group">
        <button type="button" class="status-pill is-active" data-status-filter="all">
          {t.trails.list.filterAll}
        </button>
        {statuses.map((status) => (
          <button type="button" class="status-pill" data-status-filter={status}>
            {t.trails.list.status[status]}
          </button>
        ))}
      </div>
    </div>

    <p class="trail-no-results" hidden>{t.trails.list.noResults}</p>

    <div class="trail-rows">
      {trails.map((trail) => {
        const translation =
          trail.trail_translations.find((tr) => tr.language === lang) ??
          trail.trail_translations[0];
        const title = translation?.title ?? "";

        return (
          <a
            href={`${isEnglish ? "/en" : ""}/trails/${trail.slug}`}
            class="trail-row"
            data-title={title.toLowerCase()}
            data-status={trail.status}
          >
            <div class="trail-info">
              <h3>{title}</h3>
              <p>{t.trails.list.status[trail.status]}</p>
              <p>{trail.distance_km}K • {trail.elevation_gain}D+</p>
            </div>
            <span class="trail-arrow">→</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(".trail-search");
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-status-filter]");
  const rows = document.querySelectorAll<HTMLAnchorElement>(".trail-row");
  const noResults = document.querySelector<HTMLElement>(".trail-no-results");

  let activeStatus = "all";

  function applyFilters() {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    let visibleCount = 0;

    rows.forEach((row) => {
      const matchesSearch = !query || (row.dataset.title ?? "").includes(query);
      const matchesStatus = activeStatus === "all" || row.dataset.status === activeStatus;
      const isVisible = matchesSearch && matchesStatus;

      row.hidden = !isVisible;
      if (isVisible) visibleCount++;
    });

    if (noResults) {
      noResults.hidden = visibleCount !== 0;
    }
  }

  searchInput?.addEventListener("input", applyFilters);

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeStatus = button.dataset.statusFilter ?? "all";
      filterButtons.forEach((b) => b.classList.toggle("is-active", b === button));
      applyFilters();
    });
  });
</script>
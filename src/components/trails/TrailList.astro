---
import "./trail-list.css";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";
import type { TrailStatus } from "../../types/trail";
import TrailFilters from "./TrailFilters.astro";

interface Props {
  trails: {
    id: string;
    slug: string;
    status: TrailStatus;
    last_visited: string;
    distance_km: number;
    elevation_gain: number;
    trail_translations: {
      language: string;
      title: string;
      description: string;
    }[];
  }[];
  lang: Lang;
}

const { trails, lang } = Astro.props;
const t = getTranslations(lang);
const isEnglish = lang === "en";
---

<section class="trail-list">
  <div class="container">
    <TrailFilters lang={lang} />

    <div class="trail-rows">
      {trails.map((trail) => {
        const translation =
          trail.trail_translations.find((tr) => tr.language === lang) ??
          trail.trail_translations[0];
        const title = translation?.title ?? "";

        return (
          <a
            href={`${isEnglish ? "/en" : ""}/trails/${trail.slug}`}
            class="trail-row"
            data-title={title.toLowerCase()}
            data-status={trail.status}
          >
            <div class="trail-info">
              <h3>{title}</h3>
              <p>{t.trails.list.status[trail.status]}</p>
              <p>{trail.distance_km}K • {trail.elevation_gain}D+</p>
            </div>
            <span class="trail-arrow">→</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

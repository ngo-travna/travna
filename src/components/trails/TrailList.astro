---
import "./trail-list.css";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";
import type { TrailStatus } from "../../types/trail";
import TrailFilters from "./TrailFilters.astro";

interface Props {
  trails: {
    id: string;
    slug: string;
    status: TrailStatus;
    last_visited: string;
    distance_km: number;
    elevation_gain: number;
    trail_translations: {
      language: string;
      title: string;
      description: string;
    }[];
  }[];
  lang: Lang;
}

const { trails, lang } = Astro.props;
const t = getTranslations(lang);
const isEnglish = lang === "en";

// TrayavnaTour always stays first; everything else is sorted alphabetically
// by its title in the current language.
const PINNED_SLUG = "tryavna-tour";

function titleFor(trail: (typeof trails)[number]) {
  const translation =
    trail.trail_translations.find((tr) => tr.language === lang) ??
    trail.trail_translations[0];
  return translation?.title ?? "";
}

const sortedTrails = [...trails].sort((a, b) => {
  if (a.slug === PINNED_SLUG) return -1;
  if (b.slug === PINNED_SLUG) return 1;
  return titleFor(a).localeCompare(titleFor(b), lang);
});
---

<section class="trail-list">
  <div class="container">
    <TrailFilters lang={lang} />

    <div class="trail-rows">
      {sortedTrails.map((trail) => {
        const title = titleFor(trail);

        return (
          <a
            href={`${isEnglish ? "/en" : ""}/trails/${trail.slug}`}
            class="trail-row"
            data-title={title.toLowerCase()}
            data-status={trail.status}
          >
            <div class="trail-info">
              <h3>{title}</h3>
              <p>{t.trails.list.status[trail.status]}</p>
              <p>{trail.distance_km}K • {trail.elevation_gain}D+</p>
            </div>
            <span class="trail-arrow">→</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

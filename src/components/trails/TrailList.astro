---
import "./trail-list.css";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<section class="trail-list">
  <div class="container">
    <a
      href="/trails/via-tryavna"
      class="trail-row"
    >
      <div class="trail-info">
        <h2>{t.trails.list.title}</h2>
        <p>14K • 820D+</p>
      </div>
      <span class="trail-arrow">
        →
      </span>
    </a>
    <!-- More trails will come from Supabase -->
  </div>
</section>
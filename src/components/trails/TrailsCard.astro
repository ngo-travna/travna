---
interface Props {
  trail: {
    title: string;
    slug: string;
    thumbnail: string;
    distance: string;
    elevationGain: string;
    difficulty: string;
  };
}

const { trail } = Astro.props;
---

<a
  href={`/trails/${trail.slug}`}
  class="trail-card"
>

  <img
    src={trail.thumbnail}
    alt={trail.title}
    loading="lazy"
  />

  <div class="trail-card-content">

    <h2>{trail.title}</h2>

    <div class="trail-meta">

      <span>📏 {trail.distance}</span>

      <span>⛰ {trail.elevationGain}</span>

    </div>

  </div>

</a>
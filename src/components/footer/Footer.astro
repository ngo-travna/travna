---
import "./footer.css";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<footer class="site-footer">

  <div class="container footer-grid">

    <section>
      <h3>{t.footer.title}</h3>
      <p>Mountain Sports Club</p>
      <p>Bulgaria, Tryavna</p>
      <p>
        <a href="mailto:ngo.travna@gmail.com">
          ngo.travna@gmail.com
        </a>
      </p>
    </section>

    <section>
      <h3>{t.footer.resources}</h3>
      <ul>
        <li><a href="#">Mountain Rescue Service</a></li>
        <li><a href="#">Weather Forecast</a></li>
        <li><a href="#">Central Balkan National Park</a></li>
      </ul>
    </section>

    <section>
      <h3>{t.footer.community}</h3>
      <ul>
        <li><a href="#">Balkana TRY</a></li>
        <li><a href="#">Instagram</a></li>
        <li><a href="#">Facebook</a></li>
      </ul>
    </section>

  </div>

  <hr class="footer-divider" />

  <p class="footer-license">
    {t.footer.copyright}
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer"
    >
      CC BY-NC-SA 4.0
    </a>
  </p>
</footer>
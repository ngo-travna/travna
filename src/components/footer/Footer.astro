---
import "./footer.css";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getTranslations(lang);
---

<footer class="site-footer">

  <div class="container footer-grid">

    <section>
      <h3>{t.footer.title}</h3>
      <p>{t.footer.organisation}</p>
      <p>{t.footer.location}</p>
      <p>
        <a href="mailto:ngo.travna@gmail.com">
          ngo.travna@gmail.com
        </a>
      </p>
    </section>

    <section>
      <h3>{t.footer.resources}</h3>
      <ul>
        <li><a href="https://www.pss-bg.bg/">{t.footer.pss}</a></li>
        <li><a href="http://www.weather.bg/index.php?koiFail=bg&lng=0">{t.footer.forecast}</a></li>
        <li><a href="https://visitcentralbalkan.net/">{t.footer.park}</a></li>
      </ul>
    </section>

    <section>
      <h3>{t.footer.community}</h3>
      <ul>
        <li><a href="#">{t.footer.instagram}</a></li>
        <li><a href="#">{t.footer.facebook}</a></li>
        <li><a href="https://balkana-try.vercel.app/">{t.footer.balkanatry}</a></li>

      </ul>
    </section>

  </div>

  <hr class="footer-divider" />

  <p class="footer-license">
    {t.footer.copyright}
    <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      target="_blank"
      rel="noopener noreferrer"
    >{" "}
      CC BY-NC-SA 4.0
    </a>
  </p>
</footer>
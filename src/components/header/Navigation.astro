---
import { getNavigation } from "../../lib/navigation";

const isEnglish = Astro.url.pathname.startsWith("/en");

const navigation = getNavigation(isEnglish);
---

<nav id="main-navigation" class="main-nav">

  <ul class="nav-list">

    {navigation.map((item) => (

      <li>
        <a href={item.href}>
          {item.label}
        </a>
      </li>

    ))}

  </ul>

</nav>
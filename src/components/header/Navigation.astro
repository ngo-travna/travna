---
import { getNavigation } from "../../lib/navigation";
import RunnerIcon from "../icons/RunnerIcon.astro";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const navigation = getNavigation(lang === "en");
---

<nav id="main-navigation" class="main-nav">
  <ul class="nav-list">

    {navigation.map((item) => (
      <li>
        {item.icon === "runner" ? (
          <a
            href={item.href}
            class="nav-icon-link"
            aria-label={item.label}
            title={item.label}
          >
            <RunnerIcon />
          </a>
        ) : (
          <a href={item.href}>
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
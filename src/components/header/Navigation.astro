---
import { getNavigation } from "../../lib/navigation";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const navigation = getNavigation(lang === "en");
---

<nav id="main-navigation" class="main-nav">
  <ul class="nav-list">

    {navigation.map((item) => (
      <li>
        <a href={item.href}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
---
import "./header.css";

import Navigation from "./Navigation.astro";
import HeaderControls from "./HeaderControls.astro";
---

<header class="site-header">

    <div class="container">

        <div class="header-content">

            <a href="/" class="logo">

                <img
                    src="/logo.svg"
                    alt="TRAVNA"
                    class="logo-image"
                />

            </a>

            <Navigation />

            <HeaderControls />

        </div>

    </div>

</header>
---
import { ArrowRight } from "../../lib/icons";
import type { Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEnglish = lang === "en";
---

<div class="tryavna-tour-promo">
  <a href={isEnglish ? "/en/tryavna-tour" : "/tryavna-tour"}>
    {isEnglish ? "Explore TryavnaTour — courses, GPX files & photos" : "Разгледай ТРЪВНА Тур — трасета, GPX файлове и снимки"}
    <ArrowRight />
  </a>
</div>

<style>
  .tryavna-tour-promo {
    display: flex;
    justify-content: center;
    padding: 0 0 2rem;
  }

  .tryavna-tour-promo a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-medium);
    background: var(--color-primary);
    color: #fefae0;
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .tryavna-tour-promo a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-medium);
  }

  .tryavna-tour-promo a :global(svg) {
    width: 1.1em;
    height: 1.1em;
  }
</style>

---
import "./events.css";
import {Library} from "../../lib/icons";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<section class="event-section">

  <div class="container"> 
    <Library class="event-icon" />
    <h2>{t.events.archive.title}</h2>

    <div class="previous-events">

      <div class="event-year">

        <h3>2026</h3>

        <ul>

          <li>Via Tryavna Trail Maintenance — July</li>

          <li>Leon Heart Olympic Triathlon — June</li>

          <li>National Ski Mountaineering Championship — March</li>

          <li>Troyan Mountain Cross — February</li>

        </ul>

      </div>

      <div class="event-year">

        <h3>2025</h3>

        <ul>

          <li>Autumn Trail Maintenance</li>

          <li>Community Hiking Weekend</li>

          <li>Summer Trail Running Meetup</li>

        </ul>

      </div>

    </div>

  </div>

</section>
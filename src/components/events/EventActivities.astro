---
import "./events.css";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---


<section class="event-section">

  <div class="container">

    <h2>{t.events.activities.title}</h2>

    <div class="activities-grid">

      <div class="activity-card">
        <h3>🛠 {t.events.activities.maintenance.title}</h3>
        <p>
          {t.events.activities.maintenance.description}
        </p>
      </div>

      <div class="activity-card">
        <h3>🥾 {t.events.activities.outdoor.title}</h3>
        <p>
          {t.events.activities.outdoor.description}
        </p>
      </div>

      <div class="activity-card">
        <h3>🎓 {t.events.activities.education.title}</h3>
        <p>
          {t.events.activities.education.description}
        </p>
      </div>

    </div> 

  </div>
  
</section>
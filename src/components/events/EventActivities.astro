---
import "./events.css";
import { Signpost, Library, TentTree } from "../../lib/icons";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="event-section">
  <div class="container">
    
    <h2>{t.events.activities.title}</h2>
    <div class="activities-grid">
      <article class="activity-card">
        <div class="icon"><Signpost /></div>
        <h3> {t.events.activities.maintenance.title}</h3>
        <p>
          {t.events.activities.maintenance.description}
        </p>
      </article>
      <article class="activity-card">
        <div class="icon"><TentTree /></div>
        <h3>{t.events.activities.outdoor.title}</h3>
        <p>
          {t.events.activities.outdoor.description}
        </p>
      </article>
      <article class="activity-card">
        <div class="icon"><Library /></div>
        <h3>{t.events.activities.education.title}</h3>
        <p>
          {t.events.activities.education.description}
        </p>
      </article>
    </div> 
  </div>
</section>
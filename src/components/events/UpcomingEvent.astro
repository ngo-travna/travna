---
import "./events.css";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<section class="event-section">

  <div class="container">

    <h2>{t.events.upcoming.title}</h2>

    <div class="upcoming-card">

      <div class="event-date-box">

        <span class="day">17</span>

        <span class="month">OCT</span>

        <span class="year">2026</span>

      </div>

      <div class="event-content">

        <h3>Autumn Trail Maintenance</h3>

        <p class="event-location">
          📍 Tryavna, Bulgaria
        </p>

        <p>
          Join us for a day dedicated to maintaining mountain trails,
          meeting like-minded people and enjoying the Balkan Mountains
          together.
        </p>

      </div>

    </div>

  </div>

</section>
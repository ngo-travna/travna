---
import "./events.css";
---

<section class="event-section">

  <div class="container">

    <h2>Upcoming Event</h2>

    <div class="upcoming-card">

      <span class="event-date">
        17 October 2026
      </span>

      <h3>Autumn Trail Maintenance</h3>

      <p class="event-location">
        Tryavna, Bulgaria
      </p>

      <p>
        Join us for a day dedicated to maintaining mountain trails,
        meeting like-minded people and enjoying the Balkan Mountains together.
      </p>

    </div>

  </div>

</section>
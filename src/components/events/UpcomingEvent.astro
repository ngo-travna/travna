---
import "./events.css";
import { MapPin } from "../../lib/icons";
import { supabase } from "../../lib/supabase";
import type { Lang } from "../../i18n";
import { getTranslations, isEnglish } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const eventColumns = `
  id,
  location,
  date,
  event_translations (
    title,
    description,
    place,
    language,
    document_link_text
  )
`;

/* Get the next upcoming event */
const { data: upcomingEvents, error: upcomingError } = await supabase
  .from("events")
  .select(eventColumns)
  .gte("date", new Date().toISOString())
  .order("date", { ascending: true })
  .limit(1);

if (upcomingError) {
  console.error("Error fetching upcoming event:", upcomingError);
}

let event = upcomingEvents?.[0] ?? null;
let isUpcoming = Boolean(event);

/* No event scheduled yet — fall back to the most recent past event
   so the section isn't left empty between editions. */
if (!event) {
  const { data: pastEvents, error: pastError } = await supabase
    .from("events")
    .select(eventColumns)
    .lt("date", new Date().toISOString())
    .order("date", { ascending: false })
    .limit(1);

  if (pastError) {
    console.error("Error fetching last event:", pastError);
  }

  event = pastEvents?.[0] ?? null;
  isUpcoming = false;
}

/* Select the correct translation */
const translation = event
  ? (
      event.event_translations.find((tr) => tr.language === lang) ??
      event.event_translations.find((tr) => tr.language === "bg")
    )
  : null;

/* Get the PDF separately */
let documentUrl: string | null = null;

if (event) {
  const { data: document, error: documentError } = await supabase
    .from("event_documents")
    .select("file_path")
    .eq("event_id", event.id)
    .maybeSingle();

  if (documentError) {
    console.error("Error fetching event document:", documentError);
  }

  if (document) {
    documentUrl = supabase.storage
      .from("event-documents")
      .getPublicUrl(document.file_path)
      .data.publicUrl;
  }
}

/* Event date */
const eventDate = event ? new Date(event.date) : null;

const day = eventDate?.getDate();

const month = eventDate
  ? new Intl.DateTimeFormat(
      isEnglish(lang) ? "en-GB" : "bg-BG",
      { month: "short" }
    )
      .format(eventDate)
      .toUpperCase()
  : null;

const year = eventDate?.getFullYear();
---

<section class="event-section">
  <div class="container">
    <h2>{isUpcoming ? t.events.upcoming.title : t.events.upcoming.lastEventTitle}</h2>

    {event && translation && (
      <div class={`upcoming-card ${!isUpcoming ? "is-past" : ""}`}>
        <div class={`event-date-box ${!isUpcoming ? "is-past" : ""}`}>
          <span class="day">{day}</span>
          <span class="month">{month}</span>
          <span class="year">{year}</span>
        </div>

        <div class="event-content">
          <h3>{translation.title}</h3>

          <p class="event-location">
            <MapPin />
            <a
              href={event.location}
              target="_blank"
              rel="noopener noreferrer"
            >
              {translation.place}
            </a>
          </p>

          <p>
            {translation.description}
          </p>

          {documentUrl && translation.document_link_text && (
            <a
              href={documentUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="event-document-link"
            >
              {translation.document_link_text} →
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</section>
---
import "./events.css";
 import {CalendarClock} from "../../lib/icons";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<section class="events-hero">

  <div class="container">
    <CalendarClock class="hero-icon" />

    <h1>{t.events.hero.title}</h1>

    <p>
      {t.events.hero.description}
    </p>

  </div>

</section>
---
import "./events.css";
import {Award} from "../../lib/icons";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
---

<section class="event-section">
  <div class="container">
    
    <h2>{t.events.competitions.title} <Award class="event-icon" /></h2>
    <p>{t.events.competitions.description}</p>
    <div class="competition-list">
      <article class="competition-item">
        <h3>Leon Heart Olympic Triathlon</h3>
        <p>Rosenets, Bulgaria · 2026 </p>
        <a href="https://lionheart.bg/utopia2026.pdf" target="_blank">
          View Results #51 →
        </a>
      </article>
      <article class="competition-item">
        <h3>National Ski Mountaineering Championship</h3>
        <p>Seven Rila Lakes, Bulgaria · 2026</p>
        <a href="https://bfka.org/userfiles/file/2026_news/02-22-DP-individual.pdf" target="_blank">
          View Results #3 →
        </a>
      </article>
      <article class="competition-item">
        <h3>National Cross-Country Run "In the Footsteps of Vasil Levski"</h3>
        <p>Troyan, Bulgaria · 2026</p>
        <a href="https://tracksport.live/r/nacionalen-kros-po-stiepkite-na-vasil-levski-2026/route/12-km-6" target="_blank">
          View Results #14 →
        </a>
      </article>
      <article class="competition-item">
        <h3>Triglav Skyrun 34K</h3>
        <p>Tazha, Bulgaria · 2025</p>
        <a href="https://tracksport.live/r/triglav-skyrun-2025/route/sky-34k-i-2300d" target="_blank">
          View Results #9 →
        </a>
      </article>
    </div>
  </div>
</section>
<!-- The data later will come from Supabase -->
---
import "./events.css";
import {supabase} from "../../lib/supabase";

import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;
const lang = isEnglish ? "en" : "bg";

const { data: competitions, error } = await supabase
  .from("competitions")
  .select(`
    id,
    date,
    location,
    result_link,
    competition_translations (
      title,
      place,
      result,
      language
    )
  `)
  .order("date", { ascending: false });

if (error) {
  console.error("Error fetching competitions:", error);
}

type CompetitionCard = {
  id: string;
  title: string;
  place: string;
  date: string;
  result: string;
  resultLink: string;
};

const dateFormatter = new Intl.DateTimeFormat(isEnglish ? "en-GB" : "bg-BG", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Pick the translation matching the current language (fall back to bg if missing)
const items: CompetitionCard[] = (competitions ?? [])
  .map((c): CompetitionCard | null => {
    const translation =
      c.competition_translations.find((tr) => tr.language === lang) ??
      c.competition_translations.find((tr) => tr.language === "bg");

    if (!translation) return null;

    const date = dateFormatter.format(new Date(c.date));

    return {
      id: c.id,
      title: translation.title,
      place: translation.place,
      date,
      result: translation.result,
      resultLink: c.result_link,
    };
  })
  .filter((item): item is CompetitionCard => item !== null);
---

<section class="event-section">
  <div class="container">

    <h2>{t.events.competitions.title}</h2>
    <p>{t.events.competitions.description}</p>
    <div class="competition-list">
      {items.map((item) => (
        <article class="competition-item">
          <h3>{item.title}</h3>
          <p>{item.place} · {item.date}</p>
          {item.resultLink && (
            <a
              href={item.resultLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isEnglish ? "View" : "Виж"} {item.result} →
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
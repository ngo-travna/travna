---
import "./trail-overview.css";
---

<section class="trail-overview">

  <div class="container">

    <h2>Trail Overview</h2>

    <div class="overview-grid">

      <div class="overview-item">
        <span class="label">Distance</span>
        <span class="value">14.2 km</span>
      </div>

      <div class="overview-item">
        <span class="label">Elevation Gain</span>
        <span class="value">+820 m</span>
      </div>

      <div class="overview-item">
        <span class="label">Highest Point</span>
        <span class="value">1520 m</span>
      </div>

      <div class="overview-item">
        <span class="label">Estimated Time</span>
        <span class="value">5–6 h</span>
      </div>

      <div class="overview-item">
        <span class="label">Activities</span>
        <span class="value">🥾 🏃</span>
      </div>

      <div class="overview-item">
        <span class="label">Difficulty</span>
        <span class="value">Moderate</span>
      </div>

    </div>

  </div>

</section>
---
import "./trail-overview.css";
import type { Trail } from "../../types/trail";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  trail: Trail;
  lang: Lang;
}
const { trail, lang } = Astro.props;
const t = getTranslations(lang);
const isEnglish = lang === "en";
const formattedLastVisited = new Date(trail.lastVisited).toLocaleDateString(
  isEnglish ? "en-GB" : "bg-BG",
  {
    day: "numeric",
    month: "long",
    year: "numeric",
  },
);
---
<section class="trail-overview">
  <div class="container">
    <h2>{t.trails.overview.title}</h2>

    <div class="overview-card">
      <div class="overview-row">
  <span class="label">{t.trails.overview.distance}</span>
  <span class="value">{trail.distance} {isEnglish ? "km" : "км."}</span>
</div>

<div class="overview-row">
  <span class="label">{t.trails.overview.elevationGain}</span>
  <span class="value">{trail.elevationGain} {isEnglish ? "m" : "м."}</span>
</div>

<div class="overview-row">
  <span class="label">{t.trails.overview.highestPoint}</span>
  <span class="value">{trail.highestPoint} {isEnglish ? "m" : "м."}</span>
</div>

<div class="overview-row">
  <span class="label">{t.trails.overview.estimatedTime}</span>
  <span class="value">{trail.durationHours} {isEnglish ? "h" : "ч."}</span>
</div>

      <div class="overview-row">
        <span class="label">{t.trails.overview.status}</span>
        <span class="value">{trail.status === "maintained" &&
          `🟢  ${t.trails.list.status.maintained}`}

        {trail.status === "partly_maintained" &&
          `🟡  ${t.trails.list.status.partly_maintained}`}

        {trail.status === "passed_by_travna" &&
          `🔵  ${t.trails.list.status.passed_by_travna}`}</span>
      </div>

      <div class="overview-row">
        <span class="label">{t.trails.overview.lastMaintenance}</span>
        <span class="value">{formattedLastVisited}</span>
      </div>
    </div>
  </div>
</section>
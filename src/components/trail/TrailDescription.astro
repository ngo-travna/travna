---
import "./trail-description.css";
import type { Trail } from "../../types/trail";
import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;

interface Props {
  trail: Trail;
}
const { trail } = Astro.props;
---

<section class="trail-description">
  <div class="container">
    <h2>{t.trails.description.title}</h2>
    <p>{trail.description}</p>
  </div>
</section>
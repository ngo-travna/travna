---
interface Props {
  gpx: string;
}

const { gpx } = Astro.props;
---

<div
  id="trail-map"
  data-gpx={gpx}
></div>

<script>
  import { initTrailMap } from "../../scripts/trail-map";

  const container = document.getElementById("trail-map");

  if (container) {
    if ("IntersectionObserver" in window) {
      // Load maplibre-gl only once the map is about to come into view,
      // instead of on every trail page load regardless of scroll position.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              observer.disconnect();
              initTrailMap();
            }
          }
        },
        { rootMargin: "300px" }
      );
      observer.observe(container);
    } else {
      // Fallback for browsers without IntersectionObserver support
      initTrailMap();
    }
  }
</script>
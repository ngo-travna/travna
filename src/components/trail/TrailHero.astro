---
import "./trail-hero.css";
import { Image } from "astro:assets";
import type { Trail } from "../../types/trail";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  trail: Trail;
  lang: Lang;
}

const { trail, lang } = Astro.props;

const t = getTranslations(lang);

const statusConfig = {
  maintained: { icon: "🟢", label: t.trails.list.status.maintained },
  partly_maintained: { icon: "🟡", label: t.trails.list.status.partly_maintained },
  passed_by_travna: { icon: "🔵", label: t.trails.list.status.passed_by_travna },
} as const;

const status = statusConfig[trail.status];
---

<section class="trail-hero">
  <div class="trail-hero-image-wrap">
    <Image
      src={trail.heroImage}
      alt=""
      class="trail-hero-image"
      layout="full-width"
      priority
      width={2400}
      height={1200}
    />
  </div>

  <div class="trail-hero-overlay">
    <div class="container">
      <h1>{trail.title}</h1>
      <span class:list={["trail-badge", `status-${trail.status}`]}>
        {status.icon} {status.label}
      </span>
    </div>
  </div>
</section>
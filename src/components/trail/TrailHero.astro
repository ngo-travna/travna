---
import "./trail-hero.css";
---

<section class="trail-hero">

  <div class="trail-hero-image"></div>

  <div class="trail-hero-overlay">

    <div class="container">

      <span class="trail-badge">
        🟢 Maintained by TRAVNA
      </span>

      <h1>Via Trayana</h1>

      <p>
        Ancient mountain route connecting the villages
        of the Tryavna region with the ridges of the
        Balkan Mountains.
      </p>

    </div>

  </div>

</section>
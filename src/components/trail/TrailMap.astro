---
import "./trail-map.css";
import TrailMapClient from "./TrailMapClient.astro";
import type { Trail } from "../../types/trail";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  trail: Trail;
  lang: Lang;
}
const { trail, lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="trail-map">
  <div class="container">
    <h2>{t.trails.map.title}</h2>
    <TrailMapClient gpx={trail.gpx} />
  </div>
</section>
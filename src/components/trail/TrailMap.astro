---
import "leaflet/dist/leaflet.css";
import "./trail-map.css";
---

<section class="trail-map">

  <div class="container">

    <h2>Trail Map</h2>

    <div id="trail-map"></div>

  </div>

</section>

<script lang="ts">
  import L from "leaflet";
  import { loadGpx } from "../../lib/gpx";

  const map = L.map("trail-map").setView([42.8667, 25.5000], 10);

L.tileLayer("https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png", {
  maxZoom: 17,
  attribution:
    "Map data: &copy; OpenStreetMap contributors, SRTM | Map style: &copy; OpenTopoMap (CC-BY-SA)",
}).addTo(map);

const geojson = await loadGpx("/gpx/zelenika-path.gpx");

console.log(geojson);

</script>

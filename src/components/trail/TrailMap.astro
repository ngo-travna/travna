---
import "./trail-map.css";
import TrailMapClient from "./TrailMapClient.astro";
import type { Trail } from "../../types/trail";
import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;

interface Props {
  trail: Trail;
}
const { trail } = Astro.props;
---

<section class="trail-map">
  <div class="container">
    <h2>{t.trails.map.title}</h2>
    <TrailMapClient gpx={trail.gpx} />
  </div>
</section>
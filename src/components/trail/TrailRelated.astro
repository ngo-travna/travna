---
import "./trail-related.css";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  trails: {
    type: "internal" | "external";
    title: string;
    href: string;
  }[];
  lang: Lang;
}
const { trails, lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="trail-related">
  <div class="container">
    <h2>{t.trails.related.title}</h2>
    <div class="related-list">
      {trails.map((trail) => (
          <a href={trail.href}
          class:list={[
            "related-link",
            { "external-link": trail.type === "external" },
          ]}
          target={trail.type === "external" ? "_blank" : undefined}
          rel={trail.type === "external" ? "noopener noreferrer" : undefined}
        >
          {trail.title}
          {trail.type === "external" && <span class="external-icon">↗</span>}
        </a>
      ))}
    </div>
  </div>
</section>
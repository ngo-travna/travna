---
import "./trail-related.css";
import bg from "../../i18n/bg";
const t = bg;

interface Props {
  trails: {
    title: string;
    href: string;
  }[];
}

const { trails } = Astro.props;
---

<section class="trail-related">
  <div class="container">
    <h2>{t.trails.related.title}</h2>
    <div class="related-list">
      {trails.map((trail) => (
        <a
          href={trail.href}
          class="related-link"
        >
          {trail.title}
        </a>
      ))}
    </div>
  </div>
</section>
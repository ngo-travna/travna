---
import "./trail-gallery.css";
import { Image } from "astro:assets";
import TrailGalleryClient from "../../components/trail/TrailGalleryClient.astro";
import type { Trail } from "../../types/trail";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  trail: Trail;
  images: {
    id: string;
    url: string;
    caption: string | null;
  }[];
  lang: Lang;
}

const { trail, images, lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="trail-gallery">
  <div class="container">
    <h2>{t.trails.gallery.title}</h2>
    <div class="gallery-grid">
      {images.map((image, index) => (
        <Image
          src={image.url}
          alt={image.caption ?? `${trail.title} ${index + 1}`}
          width={1280}
          height={720}
          fit="inside"
          loading="lazy"
          class="gallery-image"
        />
      ))}
    </div>
    <TrailGalleryClient />
  </div>
</section>
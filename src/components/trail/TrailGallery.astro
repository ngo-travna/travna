---
import "./trail-gallery.css";
import TrailGalleryClient from "../../components/trail/TrailGalleryClient.astro";

import type { Trail } from "../../types/trail";

interface Props {
  trail: Trail;
}

const { trail } = Astro.props;
---

<section class="trail-gallery">
  <div class="container">
    <h2>Gallery</h2>
    <div class="gallery-grid">
      {trail.gallery.map((image, index) => (
        <img
          src={image}
          alt={`${trail.title} ${index + 1}`}
          class="gallery-image"
        />
      ))}
    </div>
    <TrailGalleryClient />
  </div>

</section>
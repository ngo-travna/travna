---
import "./hero.css";
import type { Lang } from "../../i18n";
import { getTranslations, isEnglish } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getTranslations(lang);

import heroImage from "../../assets/images/hero/hero-central-balkan.jpg";

import { Image } from "astro:assets";
---

<section class="hero">
    <Image
        src={heroImage}
        alt="Central Balkan mountains"
        class="hero-image"
        layout="full-width"
        priority
    />
    <div class="hero-overlay">
        <div class="container">
            <div class="hero-content">
                <img
                    src="/logo.svg"
                    alt="TRAVNA"
                    class="hero-logo"
                />
                <div class="hero-text">
                    <h1>{t.home.hero.title}</h1>
                    <p class="hero-tagline">
                        {t.home.hero.tagline}
                    </p>
                    <p class="hero-description">
                        {t.home.hero.description}
                    </p>
                </div>
                <a
                    href={isEnglish(lang) ? "/en/trails" : "/trails"}
                    class="hero-button"
                    >
                    {t.home.hero.button}
                    </a>
            </div>
        </div>
    </div>
</section>
---
import "./hero.css";
import bg from "../../i18n/bg";
import en from "../../i18n/en";

const isEnglish = Astro.url.pathname.startsWith("/en");
const t = isEnglish ? en : bg;

import heroImage from "../../assets/images/hero/hero-central-balkan.jpg";

import { Image } from "astro:assets";
---

<section class="hero">
    <Image
        src={heroImage}
        alt="Central Balkan mountains"
        class="hero-image"
        priority
    />
    <div class="hero-overlay">
        <div class="container">
            <div class="hero-content">
                <img
                    src="/logo.svg"
                    alt="TRAVNA"
                    class="hero-logo"
                />
                <div class="hero-text">
                    <h1>{t.home.hero.title}</h1>
                    <p class="hero-tagline">
                        {t.home.hero.tagline}
                    </p>
                    <p class="hero-description">
                        {t.home.hero.description}
                    </p>
                </div>
                <a
                    href={isEnglish ? "/en/trails" : "/trails"}
                    class="hero-button"
                    >
                    {t.home.hero.button}
                    </a>
            </div>
        </div>
    </div>
</section>
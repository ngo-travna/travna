---
import "./coming-soon.css";
import RunnerIcon from "../icons/RunnerIcon.astro";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="tour-coming-soon">
  <div class="container">
    <RunnerIcon />
    <h1>{t.tryavnaTour.comingSoon.title}</h1>
    <p>{t.tryavnaTour.comingSoon.text}</p>
  </div>
</section>

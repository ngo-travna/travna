---
import "./coming-soon.css";
import RunnerIcon from "../../assets/icons/runner.svg";
import FamilyRunnersIcon from "../../assets/icons/family-runners.svg";
import { Image } from "astro:assets";
import { getTryavnaTourImageUrl } from "../../lib/images";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const photos = [
  { src: getTryavnaTourImageUrl("tt-running.jpg"), caption: t.tryavnaTour.running },
  { src: getTryavnaTourImageUrl("tt-cycling.jpg"), caption: t.tryavnaTour.cycling },
];

const profiles = [
  { src: getTryavnaTourImageUrl("track-profile-21K.png"), title: t.tryavnaTour.profiles.title21, alt: t.tryavnaTour.profiles.km21 },
  { src: getTryavnaTourImageUrl("track-profile-51K.png"), title: t.tryavnaTour.profiles.title51, alt: t.tryavnaTour.profiles.km51 },
];

const events = [
  t.tryavnaTour.family.duathlon,
  t.tryavnaTour.family.orienteering,
  t.tryavnaTour.family.chess,
];
---

<section class="tour-coming-soon">
  <div class="container">
    <RunnerIcon class="runner-icon" aria-hidden="true" focusable="false" />
    <h1>{t.tryavnaTour.comingSoon.title}</h1>
  </div>

  <div class="tour-photos">
    {photos.map((photo) => (
      <figure>
        <Image
          src={photo.src}
          alt=""
          width={1600}
          height={720}
          widths={[640, 960, 1600]}
          sizes="(max-width: 640px) 100vw, 50vw"
          fit="inside"
          loading="lazy"
        />
        <figcaption>{photo.caption}</figcaption>
      </figure>
    ))}
  </div>

  <div class="container">
    <h2>{t.tryavnaTour.intro.title}</h2>
    <ul class="tour-facts">
      {t.tryavnaTour.intro.facts.map((fact) => (
        <li>
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
        </li>
      ))}
    </ul>
    {t.tryavnaTour.intro.paragraphs.map((text) => <p>{text}</p>)}
    <p>{t.tryavnaTour.intro.landmarksLead}</p>
    <ul class="tour-landmarks">
      {t.tryavnaTour.intro.landmarks.map((name) => <li>{name}</li>)}
    </ul>
  </div>

  <div class="container tour-profiles">
    {profiles.map((profile, index) => (
      <>
      <div class="tour-profile">
        <h3>{profile.title}</h3>
        <button
          type="button"
          class="profile-trigger"
          data-full={profile.src}
          data-alt={profile.alt}
          aria-label={`${profile.alt}. ${t.tryavnaTour.profiles.open}`}
        >
          <Image
            src={profile.src}
            alt=""
            inferSize
            widths={[640, 960, 1440, 1800]}
            sizes="(max-width: 1100px) 100vw, 1100px"
            loading="lazy"
          />
        </button>
      </div>
      {index === 0 && <p class="tour-note">{t.tryavnaTour.profiles.note}</p>}
      </>
    ))}
  </div>

  <div class="container tour-family">
    <FamilyRunnersIcon class="family-icon" aria-hidden="true" focusable="false" />
    <h2>{t.tryavnaTour.family.title}</h2>
    {events.map((event) => (
      <article class="tour-event">
        <h3>{event.title}</h3>
        {"subtitle" in event && <p class="tour-subheading">{event.subtitle}</p>}
        <p>{event.text}</p>
      </article>
    ))}
  </div>

  <dialog class="profile-dialog" aria-label={t.tryavnaTour.profiles.open}>
    <button type="button" class="profile-close" aria-label={t.tryavnaTour.profiles.close}>×</button>
    <img class="profile-full" src="" alt="" />
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".profile-dialog");
  const full = dialog?.querySelector<HTMLImageElement>(".profile-full");
  const phone = window.matchMedia("(max-width: 640px)");

  document.querySelectorAll<HTMLButtonElement>(".profile-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!phone.matches || !dialog || !full) return;
      full.src = trigger.dataset.full ?? "";
      full.alt = trigger.dataset.alt ?? "";
      dialog.showModal();
    });
  });

  dialog?.querySelector(".profile-close")?.addEventListener("click", () => dialog.close());
</script>

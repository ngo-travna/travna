---
import "./tryavna-tour.css";
import "../trail/trail-gallery.css";
import { Image, getImage } from "astro:assets";
import TrailGalleryClient from "../trail/TrailGalleryClient.astro";
import type { Lang } from "../../i18n";
import { getTranslations } from "../../i18n";

interface Props {
  images: { id: string; url: string; caption: string | null }[];
  lang: Lang;
}

const { images, lang } = Astro.props;
const t = getTranslations(lang);

// Same thumbnail/full-size split as the trail gallery: a small grid image
// plus a larger variant for the lightbox.
const galleryImages = await Promise.all(
  images.map(async (image, index) => {
    const full = await getImage({
      src: image.url,
      width: 1920,
      height: 1080,
      fit: "inside",
    });
    return {
      ...image,
      alt: image.caption ?? `TryavnaTour ${index + 1}`,
      fullSrc: full.src,
    };
  }),
);
---

{galleryImages.length > 0 && (
  <section class="tryavna-tour-gallery">
    <div class="container">
      <h2>{t.tryavnaTour.gallery.title}</h2>
      <div class="gallery-grid">
        {galleryImages.map((image) => (
          <div class="gallery-image-wrap">
            <Image
              src={image.url}
              alt={image.alt}
              width={1280}
              height={720}
              fit="inside"
              loading="lazy"
              class="gallery-image"
              data-full-src={image.fullSrc}
            />
          </div>
        ))}
      </div>
      <TrailGalleryClient />
    </div>
  </section>
)}

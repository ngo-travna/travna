---
import "./elevation-profile.css";
import {
  buildElevationProfileSvg,
  downsampleProfile,
  type ElevationPoint,
} from "../../lib/elevationProfile";
import type { Lang } from "../../i18n";

interface Props {
  points: ElevationPoint[];
  lang: Lang;
}

const { points, lang } = Astro.props;
const isEnglish = lang === "en";

const width = 600;
const height = 160;

const sampled = downsampleProfile(points, 150);
const { areaPath, linePath, minElevationM, maxElevationM } =
  buildElevationProfileSvg(sampled, width, height);
---

<div class="elevation-profile">
  <svg
    class="elevation-profile-svg"
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="none"
    role="img"
    aria-label={isEnglish
      ? `Elevation profile, from ${Math.round(minElevationM)} to ${Math.round(maxElevationM)} meters`
      : `Профил на денивилацията, от ${Math.round(minElevationM)} до ${Math.round(maxElevationM)} метра`}
  >
    <defs>
      <linearGradient id="elevation-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-secondary)" stop-opacity="0.35" />
        <stop offset="100%" stop-color="var(--color-secondary)" stop-opacity="0.02" />
      </linearGradient>
    </defs>
    <path d={areaPath} fill="url(#elevation-fill)" stroke="none" />
    <path
      d={linePath}
      fill="none"
      stroke="var(--color-secondary)"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"
    />
  </svg>

  <div class="elevation-profile-labels">
    <span>{Math.round(maxElevationM)} {isEnglish ? "m" : "м."}</span>
    <span>{Math.round(minElevationM)} {isEnglish ? "m" : "м."}</span>
  </div>
</div>

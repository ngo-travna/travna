---
import "../styles/global.css";
import "../styles/fonts.css";
import latinFontUrl from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import cyrillicFontUrl from "@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url";
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import Analytics from '@vercel/analytics/astro'

interface Props {
  title: string;
  description?: string;
  lang?: "bg" | "en";
}
const {
  title,
  description = "TRAVNA – NGO for preserving and promoting the mountain trails around Tryavna and the Central Balkan.",
  lang = "en",
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>{title}</title>
  <meta
    name="description"
    content={description}
  />
  <link rel="icon" href="/favicon.ico" />

  <!-- Latin is always needed (nav shows "BG"/"EN" in Latin on every page);
       Cyrillic is only preloaded on Bulgarian pages. Preloading gives the
       font-display: optional font (see fonts.css) the best chance of
       being ready in time, instead of falling back for the whole load. -->
  <link rel="preload" as="font" type="font/woff2" href={latinFontUrl} crossorigin />
  {lang === "bg" && (
    <link rel="preload" as="font" type="font/woff2" href={cyrillicFontUrl} crossorigin />
  )}

  <script>
    import { initializeTheme } from "../lib/theme.js";
    initializeTheme();
  </script>

</head>
<body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />

    <script>
      import { toggleTheme } from "../lib/theme";
      document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
    </script>

    <Analytics />
</body>
</html>